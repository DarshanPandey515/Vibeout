DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
INTERNAL_SIGNING_KEY=

DATABASE_URL=

MAX_UPLOAD_SIZE_MB=20

# Backblaze B2 (S3-compatible)
# S3_ENDPOINT_URL: https://s3.<region>.backblazeb2.com  e.g. https://s3.us-west-004.backblazeb2.com
# S3_REGION: the region in your endpoint, e.g. us-west-004
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# true = run jobs synchronously in-process (local dev); false = real QStash (needs public PUBLIC_BASE_URL)
QSTASH_INLINE=
PUBLIC_BASE_URL=http://localhost:8000

GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
# low/medium/high; empty string for models that don't support reasoning_effort
GROQ_REASONING_EFFORT=low

LIVEKIT_SIP_URI=

CORS_ALLOWED_ORIGINS=http://localhost:5173